# Copia este archivo como .env y completa tus datos.
# También puedes pasarlos por parámetros o dejarlos vacíos para que el bot los pida.

SUNAT_RUC=
SUNAT_USER=
SUNAT_PASSWORD=

# factura | boleta
SUNAT_DOCUMENTO=factura

# 10 emitidas | 11 recibidas | 12 rechazadas
# 13/14 notas de crédito | 15/16 notas de débito
SUNAT_TIPO=10

# Formato YYYY-MM-DD. Si se dejan vacías, usa el mes actual.
SUNAT_DESDE=
SUNAT_HASTA=

# true = navegador oculto (default); false = muestra el navegador (útil si SUNAT pide captcha)
SUNAT_HEADLESS=true

# Opcionales
# Concurrencia para descargar comprobantes recibidos (1 a 5). SUNAT tarda ~10 s
# por archivo; bájalo si responde con errores.
# SUNAT_CONCURRENCY=3
# SUNAT_CONSULTA_URL=https://ww1.sunat.gob.pe/ol-ti-itconscpemype/consultar.do
# SUNAT_STATE_TTL_MS=600000
# Reutilizar la sesión guardada. Por defecto false: siempre hace login limpio.
# SUNAT_REUSE_SESSION=false
