# Copia este archivo como .env y completa tus datos.
# También puedes pasarlos por parámetros o dejarlos vacíos para que el bot los pida.

SUNAT_RUC=
SUNAT_USER=
SUNAT_PASSWORD=

# factura | boleta
SUNAT_DOCUMENTO=factura

# 10 emitidas | 11 recibidas | 12 rechazadas
# 13/14 notas de crédito | 15/16 notas de débito
SUNAT_TIPO=10

# Formato YYYY-MM-DD. Si se dejan vacías, usa el mes actual.
SUNAT_DESDE=
SUNAT_HASTA=

# true = navegador oculto (default); false = muestra el navegador (útil si SUNAT pide captcha)
SUNAT_HEADLESS=true

# Opcionales
# Concurrencia para descargar comprobantes recibidos (1 a 5). SUNAT tarda ~10 s
# por archivo; bájalo si responde con errores.
# SUNAT_CONCURRENCY=2
# SUNAT_CONSULTA_URL=https://ww1.sunat.gob.pe/ol-ti-itconscpemype/consultar.do
# SUNAT_STATE_TTL_MS=600000
# Reutilizar la sesión guardada. Por defecto false: siempre hace login limpio.
# SUNAT_REUSE_SESSION=false
# Espera máxima por la propuesta SIRE (ms) y cada cuánto consultar el ticket.
# SUNAT_SIRE_TICKET_WAIT_MS=210000
# SUNAT_SIRE_TICKET_POLL_MS=3000
# Tickets nuevos a solicitar si SUNAT marca el anterior como expirado.
# SUNAT_SIRE_TICKET_RETRIES=2
# Caché del listado de propuestas SIRE para no generar tickets repetidos.
# 0 desactiva el caché. Por defecto: 1 h para el mes actual y 6 h para
# periodos cerrados. Se guarda comprimido en .cache/sire/.
# SUNAT_SIRE_CACHE_TTL_MS=
# SUNAT_SIRE_CACHE_DIR=

# ===== Buzón SOL -> WhatsApp (multiempresa) =====
# Las empresas (RUC, usuario, clave SOL y WhatsApp) se administran desde la UI
# y se guardan cifradas en empresas.json, junto a una clave local .buzon.key.
# Opcional: define una clave maestra propia para cifrar con ella.
# SUNAT_MASTER_KEY=

# Páginas por bandeja (mensajes y notificaciones) al revisar el buzón.
BUZON_MAX_PAGES=20

# Revisión automática desde el servidor (la UI no necesita estar abierta).
BUZON_AUTO=false
BUZON_INTERVAL_MIN=15

# Endpoints internos del visor del Buzón. Normalmente no hay que cambiarlos.
# SUNAT_BUZON_URL=https://ww1.sunat.gob.pe/ol-ti-itvisornoti/visor
# SUNAT_BUZON_MENU_URL=https://e-menu.sunat.gob.pe/cl-ti-itmenu/MenuInternet.htm?action=buzon&s=ww1
# SUNAT_BUZON_LINK=https://e-menu.sunat.gob.pe/cl-ti-itmenu/MenuInternet.htm?action=buzon&s=ww1
